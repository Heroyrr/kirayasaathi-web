# Your public website address (no slash at the end). Used for SEO, the sitemap and share previews.
NEXT_PUBLIC_SITE_URL=https://kirayasaathi.in

# WhatsApp number with country code, digits only (shown on the floating button and the forms)
NEXT_PUBLIC_WHATSAPP=91XXXXXXXXXX

# Public contact email shown in the footer and on the privacy page
NEXT_PUBLIC_CONTACT_EMAIL=hello@kirayasaathi.in

# Supabase (same project as the app). The anon key is public. Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Link to the Android APK (Supabase Storage, Google Drive or GitHub Releases). Shown only on the hidden /download page.
NEXT_PUBLIC_APK_URL=

# Optional: Google Search Console verification code
NEXT_PUBLIC_GOOGLE_VERIFICATION=
